{
  "schemaVersion": 1,
  "ledgerVersion": "1.0.0",
  "capabilities": [
    { "id": "grammar-model", "owner": "Grammar", "maturity": "stable", "summary": "Canonical grammar model, analysis, normalization, and notation transformations." },
    { "id": "parser-contracts", "owner": "Parser", "maturity": "stable", "summary": "Engine-neutral parse outcomes, diagnostics, forests, replay, and recovery contracts." },
    { "id": "lexical-runtime", "owner": "Lexer", "maturity": "stable", "summary": "Tokenization and lexical runtime used by parser and tooling consumers." },
    { "id": "ll-engine", "owner": "LL-Parsing", "maturity": "stable", "summary": "Predictive LL(1) parsing with token-level replay for compatible grammars." },
    { "id": "earley-engine", "owner": "Earley-Parser", "maturity": "stable", "summary": "General Earley parsing with portable forest traversal and ambiguity evidence." },
    { "id": "earley-table-engine", "owner": "Earley-TableParser", "maturity": "stable", "summary": "Validated table-driven Earley variants with truthful lookahead behavior." },
    { "id": "cyk-engine", "owner": "CYK-Parser", "maturity": "stable", "summary": "CYK parsing over canonical Grammar-owned normal-form transformations." },
    { "id": "rnglr-engine", "owner": "RNGLR-Parser", "maturity": "stable", "summary": "RNGLR generalized parsing with portable shared-forest evidence." },
    { "id": "lr-engine", "owner": "LR-Parsing", "maturity": "stable", "summary": "LR(0), SLR, LALR, and canonical LR(1) construction and runtime ownership." },
    { "id": "semantic-evaluation", "owner": "Compiler", "maturity": "stable", "summary": "Derivation-aware semantic evaluation and convergence classification." },
    { "id": "reproducible-experiments", "owner": "Grammar-REPL", "maturity": "stable", "summary": "Serializable, replayable engine and semantic comparison experiments." },
    { "id": "integration-research-ui", "owner": "Grammar-Workbench", "maturity": "stable", "summary": "Integrated experiment, counterexample, benchmark, and publication exploration." },
    { "id": "research-notebooks", "owner": "Grammar-Workbench", "maturity": "stable", "summary": "Fingerprint-preserving narrative notebooks over named Grammar-REPL experiment projects." },
    { "id": "engine-microbenchmark-contract", "owner": "Parser", "maturity": "stable", "summary": "Parser owns the fail-closed report envelope consumed by engine-owned workloads and Workbench research views." },
    { "id": "public-research-release", "owner": "Grammar-Workbench", "maturity": "stable", "summary": "Citation-ready archival release binding claims, limitations, evidence, benchmarks, corpus, capabilities, and exact provenance." },
    { "id": "public-extension-host", "owner": "Grammar-Workbench", "maturity": "stable", "summary": "Versioned in-process extension discovery and bounded portable results." }
  ],
  "repositories": [
    { "name": "Grammar", "role": "grammar-model", "minimumVersion": "0.3.4", "provides": ["grammar-model"], "consumes": [] },
    { "name": "Parser", "role": "parser-contracts", "minimumVersion": "0.4.1", "provides": ["parser-contracts", "engine-microbenchmark-contract"], "consumes": ["grammar-model"] },
    { "name": "Lexer", "role": "lexical-runtime", "minimumVersion": "0.2.0", "provides": ["lexical-runtime"], "consumes": ["grammar-model"] },
    { "name": "LL-Parsing", "role": "ll-engine", "minimumVersion": "0.1.2", "provides": ["ll-engine"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "engine-microbenchmark-contract"] },
    { "name": "Earley-Parser", "role": "earley-engine", "minimumVersion": "0.2.1", "provides": ["earley-engine"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "engine-microbenchmark-contract"] },
    { "name": "Earley-TableParser", "role": "earley-table-engine", "minimumVersion": "0.2.1", "provides": ["earley-table-engine"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "engine-microbenchmark-contract"] },
    { "name": "CYK-Parser", "role": "cyk-engine", "minimumVersion": "0.2.1", "provides": ["cyk-engine"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "engine-microbenchmark-contract"] },
    { "name": "RNGLR-Parser", "role": "rnglr-engine", "minimumVersion": "0.2.3", "provides": ["rnglr-engine"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "engine-microbenchmark-contract"] },
    { "name": "LR-Parsing", "role": "lr-engine", "minimumVersion": "0.2.5", "provides": ["lr-engine"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "engine-microbenchmark-contract"] },
    { "name": "Compiler", "role": "semantic-owner", "minimumVersion": "0.3.0", "provides": ["semantic-evaluation"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime"] },
    { "name": "Grammar-REPL", "role": "experiment-owner", "minimumVersion": "0.9.0", "provides": ["reproducible-experiments"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "ll-engine", "earley-engine", "earley-table-engine", "cyk-engine", "rnglr-engine", "lr-engine", "semantic-evaluation"] },
    { "name": "Grammar-Workbench", "role": "integration-coordinator", "minimumVersion": "1.0.31", "provides": ["integration-research-ui", "public-extension-host", "research-notebooks", "public-research-release"], "consumes": ["grammar-model", "parser-contracts", "lexical-runtime", "lr-engine", "semantic-evaluation", "reproducible-experiments", "engine-microbenchmark-contract"] }
  ],
