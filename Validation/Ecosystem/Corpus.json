    { "id": "json-string", "grammar": "json-subset", "input": "\"hello\"", "expectedTokenKinds": ["STRING"], "expectedStatus": "accepted", "expectedRoot": "Value", "expectedAmbiguous": false, "expectedDiagnostic": null, "expectedRecovery": null, "tags": ["literal", "string"] },
    { "id": "json-empty-array", "grammar": "json-subset", "input": "[]", "expectedTokenKinds": ["LBRACKET", "RBRACKET"], "expectedStatus": "accepted", "expectedRoot": "Value", "expectedAmbiguous": false, "expectedDiagnostic": null, "expectedRecovery": null, "tags": ["epsilon", "recursive"] },
    { "id": "json-empty-object", "grammar": "json-subset", "input": "{}", "expectedTokenKinds": ["LBRACE", "RBRACE"], "expectedStatus": "accepted", "expectedRoot": "Value", "expectedAmbiguous": false, "expectedDiagnostic": null, "expectedRecovery": null, "tags": ["epsilon", "recursive"] },
    { "id": "json-flat-array", "grammar": "json-subset", "input": "[1,2,3]", "expectedTokenKinds": ["LBRACKET", "NUMBER", "COMMA", "NUMBER", "COMMA", "NUMBER", "RBRACKET"], "expectedStatus": "accepted", "expectedRoot": "Value", "expectedAmbiguous": false, "expectedDiagnostic": null, "expectedRecovery": null, "tags": ["list", "recursive"] },
