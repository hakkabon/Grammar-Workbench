    { "id": "earley-el", "family": "generalized", "forest": "portable", "replay": "forestTraversal", "requires": [] },
    { "id": "cyk", "family": "generalized", "forest": "portable", "replay": "forestTraversal", "requires": [] },
    { "id": "rnglr", "family": "generalized", "forest": "portable", "replay": "forestTraversal", "requires": [] },
