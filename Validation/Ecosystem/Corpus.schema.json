{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hakkabon/Grammar-Workbench/Validation/Ecosystem/Corpus.schema.json",
  "title": "Grammar parser ecosystem conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engines", "grammars", "cases"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "engines": {
      "type": "array", "minItems": 7, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "family", "forest", "replay"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "family": { "enum": ["generalized", "deterministic"] },
          "forest": { "enum": ["portable", "none"] },
          "replay": { "enum": ["forestTraversal", "runtimeTrace"] }
        }
      }
    },
    "grammars": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "start", "terminals", "precedence", "productions"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "source": { "type": "string", "pattern": "^Examples/Corpus/[^/]+\\.grammar$" },
          "start": { "$ref": "#/$defs/symbol" },
          "terminals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/symbol" } },
          "precedence": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["associativity", "terminals"],
              "properties": {
                "associativity": { "enum": ["left", "right", "nonAssociative"] },
                "terminals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/symbol" } }
              }
            }
          },
          "productions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "lhs", "rhs"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "lhs": { "$ref": "#/$defs/symbol" },
                "rhs": { "type": "array", "items": { "$ref": "#/$defs/symbol" } }
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 25,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "grammar", "input", "expectedTokenKinds", "expectedStatus", "expectedRoot", "expectedAmbiguous", "expectedDiagnostic", "expectedRecovery", "tags"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "grammar": { "$ref": "#/$defs/identifier" },
          "input": { "type": "string" },
          "expectedTokenKinds": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
          "expectedStatus": { "enum": ["accepted", "acceptedWithRecovery", "rejected", "lexicalError"] },
          "expectedRoot": { "oneOf": [{ "$ref": "#/$defs/symbol" }, { "type": "null" }] },
          "expectedAmbiguous": { "type": "boolean" },
          "expectedDiagnostic": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object", "additionalProperties": false,
                "required": ["tokenIndex", "unexpected", "expectedTerminals"],
                "properties": {
                  "tokenIndex": { "type": "integer", "minimum": 0 },
                  "unexpected": { "$ref": "#/$defs/symbol" },
                  "expectedTerminals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/symbol" } }
                }
              }
            ]
          },
          "expectedRecovery": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "terminal", "tokenIndex"],
                "properties": {
                  "kind": { "enum": ["insert", "delete"] },
                  "terminal": { "$ref": "#/$defs/symbol" },
                  "tokenIndex": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          },
          "expectedReplay": {
            "type": "object", "additionalProperties": false,
            "required": ["terminal", "requiredEvents", "productionIDs"],
            "properties": {
              "terminal": { "enum": ["accept", "reject"] },
              "requiredEvents": {
                "type": "array", "minItems": 2, "uniqueItems": true,
                "items": { "enum": ["start", "inspect", "consume", "applyProduction", "discoverAmbiguity", "recover", "accept", "reject"] }
              },
              "productionIDs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
            }
          },
          "expectedForest": {
            "type": "object", "additionalProperties": false,
            "required": ["generalizedDerivations", "ambiguous", "productionIdentity", "acceptedDifferences"],
            "properties": {
              "generalizedDerivations": { "type": "integer", "minimum": 1 },
              "ambiguous": { "type": "boolean" },
              "productionIdentity": { "const": "required" },
              "acceptedDifferences": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["engine", "status", "reason"],
                  "properties": {
                    "engine": { "$ref": "#/$defs/identifier" },
                    "status": { "enum": ["accepted", "acceptedWithRecovery", "rejected", "lexicalError"] },
                    "reason": { "type": "string", "minLength": 20 }
                  }
                }
              }
            }
          },
          "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
        },
        "allOf": [{
          "if": { "properties": { "tags": { "contains": { "const": "engine-comparison" } } }, "required": ["tags"] },
          "then": { "required": ["expectedReplay", "expectedForest"] }
        }]
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
