{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hakkabon/Grammar-Workbench/Validation/Ecosystem/DependencyBoundaries.schema.json",
  "title": "Grammar ecosystem dependency boundary policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "packages", "allowedRequirementKinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "identity", "owner", "layer", "kind", "audited"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "manifestName": { "type": "string", "minLength": 1 },
          "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "layer": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["ecosystem", "external"] },
          "audited": { "type": "boolean" },
          "allowedDependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "audited": { "const": true } } },
            "then": { "required": ["manifestName", "allowedDependencies"] }
          }
        ]
      }
    },
    "allowedRequirementKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["exact", "range", "revision"] }
    }
  }
}
