{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammar-workbench.dev/schemas/research-distribution-v1.json",
  "title": "Grammar Workbench research distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "title", "softwareVersion", "publicAPIVersion",
    "programmeID", "programmeFingerprint", "evidenceFingerprint",
    "ecosystemContractVersion", "digestAlgorithm", "license", "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "grammar-workbench-research-distribution" },
    "title": { "type": "string", "minLength": 1 },
    "softwareVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publicAPIVersion": { "type": "integer", "minimum": 1 },
    "programmeID": { "type": "string", "minLength": 1 },
    "programmeFingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "evidenceFingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "ecosystemContractVersion": { "type": "string", "minLength": 1 },
    "digestAlgorithm": { "const": "sha256" },
    "license": { "const": "MIT" },
    "files": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "bytes", "sha256"],
        "properties": {
          "path": {
            "enum": ["CITATION.cff", "LICENSE.txt", "README.md", "ecosystem.json", "programme.json", "report.json"]
          },
          "mediaType": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
