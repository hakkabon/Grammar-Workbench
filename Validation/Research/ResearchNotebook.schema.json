{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hakkabon/Grammar-Workbench/Validation/Research/ResearchNotebook.schema.json",
  "title": "Grammar Workbench research notebook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "producer", "title", "researchQuestion",
    "project", "cells", "fingerprintAlgorithm", "fingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "grammar-workbench-research-notebook" },
    "producer": { "$ref": "#/$defs/producer" },
    "title": { "type": "string", "minLength": 1 },
    "researchQuestion": { "type": "string", "minLength": 1 },
    "project": { "$ref": "#/$defs/project" },
    "cells": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/cell" }
    },
    "fingerprintAlgorithm": { "const": "fnv1a64" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "Grammar-Workbench" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "experimentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tags", "fingerprint", "input", "agreement", "engines"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "input": { "type": "string" },
        "agreement": { "enum": ["complete", "acceptanceOnly", "divergent", "inconclusive"] },
        "engines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fingerprint", "producerVersion", "experiments"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "producerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "experiments": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/experimentReference" } }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "body", "selectedEngines"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["note", "evidence", "conclusion"] },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "experimentID": { "type": "string", "minLength": 1 },
        "selectedEngines": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
